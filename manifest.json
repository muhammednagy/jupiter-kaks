{
  "manifest_version": 3,
  "name": "Jupiter Kaks",
  "version": "1.2.1",
  "description": "Watch Jupiter with Estonian captions and free English translations together.",
  "minimum_chrome_version": "111",
  "permissions": ["storage"],
  "host_permissions": ["https://api.tartunlp.ai/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Jupiter Kaks" },
  "content_scripts": [
    {
      "matches": ["https://jupiter.err.ee/*"],
      "js": ["page-bridge.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": ["https://jupiter.err.ee/*"],
      "js": ["shared.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
