{
  "manifest_version": 3,
  "name": "Jupiter Kaks",
  "version": "1.3.0",
  "description": "Watch Jupiter with Estonian captions and free English translations together.",
  "minimum_chrome_version": "111",
  "permissions": ["storage"],
  "host_permissions": ["https://api.tartunlp.ai/*"],
  "background": { "service_worker": "background.js" },
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": { "default_popup": "popup.html", "default_title": "Jupiter Kaks", "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png" } },
  "content_scripts": [
    {
      "matches": ["https://jupiter.err.ee/*"],
      "js": ["page-bridge.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": ["https://jupiter.err.ee/*"],
      "js": ["shared.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
